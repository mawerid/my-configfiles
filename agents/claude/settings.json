{
    "env": {
        "DISABLE_TELEMETRY": "1",
        "DISABLE_ERROR_REPORTING": "1",
        "DISABLE_FEEDBACK_COMMAND": "1",
        "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
        "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
    },
    "permissions": {
        "allow": [
            "Bash(pwd)",
            "Bash(ls)",
            "Bash(ls *)",
            "Bash(tree)",
            "Bash(tree *)",
            "Bash(git status)",
            "Bash(git status *)",
            "Bash(git diff)",
            "Bash(git diff *)",
            "Bash(git log)",
            "Bash(git log *)",
            "Bash(python -V)",
            "Bash(python3 -V)",
            "Bash(node -v)",
            "Bash(npm -v)",
            "Bash(uv --version)",
            "Bash(cargo --version)",
            "Bash(cmake --version)",
            "Bash(go version)"
        ],
        "deny": [
            "Bash(git push*)",
            "Bash(rm *)",
            "Bash(ssh *)",
            "Bash(scp *)",
            "Read(//**/.env)",
            "Read(//**/.env.*)",
            "Read(//**/*.env)",
            "Read(//**/*.env.*)",
            "Read(//**/*.pem)",
            "Read(//**/*.key)",
            "Read(//**/*.p12)",
            "Read(//**/*.crt)",
            "Read(//**/*.der)",
            "Read(//**/*.pfx)",
            "Read(//**/*.sqlite)",
            "Read(//**/*.db)",
            "Read(//**/*.kdbx)",
            "Read(//**/id_rsa*)",
            "Read(//**/id_ecdsa*)",
            "Read(//**/id_ed25519*)",
            "Read(~/.ssh/**)",
            "Read(~/.aws/**)",
            "Read(~/.gnupg/**)",
            "Read(~/.kube/**)",
            "Read(~/.docker/config.json)",
            "Read(~/.netrc)",
            "Read(~/.pypirc)",
            "Read(~/.config/gh/**)",
            "Read(~/.config/glab-cli/**)"
        ]
    },
    "sandbox": {
        "enabled": true,
        "failIfUnavailable": true,
        "autoAllowBashIfSandboxed": false,
        "allowUnsandboxedCommands": false,
        "excludedCommands": [
            "glab *",
            "docker *",
            "python3 *mr_workflow.py *"
        ]
    },
    "skillOverrides": {
        "approve-mr": "on",
        "close-cycle": "on",
        "create-mr": "on",
        "debug": "on",
        "design": "on",
        "execute": "on",
        "explore": "on",
        "handoff": "on",
        "idea": "on",
        "next": "on",
        "plan": "on",
        "refactor-review": "on",
        "release": "on",
        "research": "on",
        "respond-mr": "on",
        "retire-plan": "on",
        "retro": "on",
        "review": "on",
        "review-mr": "on",
        "test": "on",
        "wait-what": "on",
        "work": "on"
    }
}
