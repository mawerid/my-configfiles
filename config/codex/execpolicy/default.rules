prefix_rule(
    pattern = ["pwd"],
    decision = "allow",
    justification = "Read-only workspace inspection.",
    match = [
        ["pwd"],
    ],
)

prefix_rule(
    pattern = ["ls"],
    decision = "allow",
    justification = "Read-only workspace inspection.",
    match = [
        ["ls"],
        ["ls", "-la"],
        ["ls", "config"],
    ],
)

prefix_rule(
    pattern = ["tree"],
    decision = "allow",
    justification = "Read-only workspace inspection.",
    match = [
        ["tree"],
        ["tree", "config"],
    ],
)

prefix_rule(
    pattern = ["git", "status"],
    decision = "allow",
    justification = "Read-only git inspection.",
    match = [
        ["git", "status"],
        ["git", "status", "--short"],
    ],
    not_match = [
        ["git", "push"],
    ],
)

prefix_rule(
    pattern = ["git", "diff"],
    decision = "allow",
    justification = "Read-only git inspection.",
    match = [
        ["git", "diff"],
        ["git", "diff", "--stat"],
    ],
)

prefix_rule(
    pattern = ["git", "log"],
    decision = "allow",
    justification = "Read-only git inspection.",
    match = [
        ["git", "log"],
        ["git", "log", "--oneline"],
    ],
)

prefix_rule(
    pattern = ["python", "-V"],
    decision = "allow",
    justification = "Local tool version check.",
)

prefix_rule(
    pattern = ["python3", "-V"],
    decision = "allow",
    justification = "Local tool version check.",
)

prefix_rule(
    pattern = ["node", "-v"],
    decision = "allow",
    justification = "Local tool version check.",
)

prefix_rule(
    pattern = ["npm", "-v"],
    decision = "allow",
    justification = "Local tool version check.",
)

prefix_rule(
    pattern = ["uv", "--version"],
    decision = "allow",
    justification = "Local tool version check.",
)

prefix_rule(
    pattern = ["cargo", "--version"],
    decision = "allow",
    justification = "Local tool version check.",
)

prefix_rule(
    pattern = ["cmake", "--version"],
    decision = "allow",
    justification = "Local tool version check.",
)

prefix_rule(
    pattern = ["go", "version"],
    decision = "allow",
    justification = "Local tool version check.",
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "Publishing changes must be explicit.",
    match = [
        ["git", "push"],
        ["git", "push", "origin", "main"],
    ],
)

prefix_rule(
    pattern = ["rm"],
    decision = "forbidden",
    justification = "Destructive file removal must be explicit.",
    match = [
        ["rm", "file"],
        ["rm", "-rf", "dir"],
    ],
)

prefix_rule(
    pattern = ["ssh"],
    decision = "forbidden",
    justification = "Remote shell access must be explicit.",
    match = [
        ["ssh", "host"],
    ],
)

prefix_rule(
    pattern = ["scp"],
    decision = "forbidden",
    justification = "Remote file transfer must be explicit.",
    match = [
        ["scp", "file", "host:path"],
    ],
)
